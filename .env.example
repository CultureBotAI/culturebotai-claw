# Mech worktree roots, one per repository in `conf/fleet.yaml`. Absolute paths
# are recommended for automation.
#
# Set the roots for the Mechs you actually work with. `openclaw-cli config
# validate` reports an unset root as "not configured locally" rather than a
# failure; pass --require-all-repositories where the whole fleet is expected.
# An unset root is never silently treated as the current directory, and any
# operation against an unconfigured repository still fails closed.
CULTUREMECH_ROOT=/absolute/path/to/CultureMech
MEDIAINGREDIENTMECH_ROOT=/absolute/path/to/MediaIngredientMech
COMMUNITYMECH_ROOT=/absolute/path/to/CommunityMech
TRAITMECH_ROOT=/absolute/path/to/TraitMech
PROTEINTRAITSMECH_ROOT=/absolute/path/to/ProteinTraitsMech

# Optional sibling repository used by selected just recipes.
KG_MICROBE_ROOT=/absolute/path/to/kg-microbe

# Makes relative runtime paths stable when commands run from another checkout.
OPENCLAW_ORCHESTRATION_ROOT=/absolute/path/to/culturebotai-claw

# Runtime artifacts are kept under the orchestration checkout by default.
OPENCLAW_WORKSPACE=workspace

# Required only for workflows that actually call Anthropic models.
ANTHROPIC_API_KEY=
