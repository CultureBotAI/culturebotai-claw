      "content": "{\n  \"schema_version\": 1,\n  \"repository\": \"scaleupmech\",\n  \"source_ref\": \"f6a00874ed153154feb26918933f2cd8110c5ec8\",\n  \"components\": {\n    \"skill:repository-freshness\": {\n      \"action\": \"defer\",\n      \"reason\": \"Existing freshness candidate is independently governed; template adoption does not install or activate a freshness runtime.\",\n      \"evidence\": [\n        \"AGENTS.md\",\n        \"justfile\",\n        \".claude/skills/curate-scale-transfer/SKILL.md\",\n        \"conf/record_review.yaml\"\n      ]\n    },\n    \"skill:triage-and-resolve-issues\": {\n      \"action\": \"adopt\",\n      \"reason\": \"Native tests, structured review and scientific skill provide the inspected infrastructure prerequisites; this installs a candidate, not runtime authority.\",\n      \"evidence\": [\n        \"AGENTS.md\",\n        \"justfile\",\n        \".claude/skills/curate-scale-transfer/SKILL.md\",\n        \"conf/record_review.yaml\"\n      ]\n    },\n    \"skill:evolve-mech-workflow\": {\n      \"action\": \"adopt\",\n      \"reason\": \"Native tests, structured review and scientific skill provide the inspected infrastructure prerequisites; this installs a candidate, not runtime authority.\",\n      \"evidence\": [\n        \"AGENTS.md\",\n        \"justfile\",\n        \".claude/skills/curate-scale-transfer/SKILL.md\",\n        \"conf/record_review.yaml\"\n      ]\n    },\n    \"skill:manage-identifiers\": {\n      \"action\": \"adopt\",\n      \"reason\": \"Native tests, structured review and scientific skill provide the inspected infrastructure prerequisites; this installs a candidate, not runtime authority.\",\n      \"evidence\": [\n        \"AGENTS.md\",\n        \"justfile\",\n        \".claude/skills/curate-scale-transfer/SKILL.md\",\n        \"conf/record_review.yaml\"\n      ]\n    },\n    \"skill:next-tasks\": {\n      \"action\": \"defer\",\n      \"reason\": \"This repository uses GitHub issues and the infrastructure intake ledger; it has no maintained NEXT_TASKS.md contract.\",\n      \"evidence\": [\n        \"AGENTS.md\",\n        \"justfile\",\n        \".claude/skills/curate-scale-transfer/SKILL.md\",\n        \"conf/record_review.yaml\"\n      ]\n    },\n    \"skill:curate-yaml-record\": {\n      \"action\": \"defer\",\n      \"reason\": \"The native curate-scale-transfer skill and new-history writer own scientific curation; generic history/identifier assumptions require a separate domain adaptation.\",\n      \"evidence\": [\n        \"AGENTS.md\",\n        \"justfile\",\n        \".claude/skills/curate-scale-transfer/SKILL.md\",\n        \"conf/record_review.yaml\"\n      ]\n    },\n    \"skill:fetch-source\": {\n      \"action\": \"defer\",\n      \"reason\": \"No maintained fixed-URL fetch recipe and source validation contract is adopted; preserve existing source provenance and native seed audit.\",\n      \"evidence\": [\n        \"AGENTS.md\",\n        \"justfile\",\n        \".claude/skills/curate-scale-transfer/SKILL.md\",\n        \"conf/record_review.yaml\"\n      ]\n    },\n    \"skill:id-label-correspondence\": {\n      \"action\": \"defer\",\n      \"reason\": \"Governed validator payload is present but a reviewed native ontology correspondence adapter is not adopted.\",\n      \"evidence\": [\n        \"AGENTS.md\",\n        \"justfile\",\n        \".claude/skills/curate-scale-transfer/SKILL.md\",\n        \"conf/record_review.yaml\"\n      ]\n    },\n    \"skill:schema-gap-analysis\": {\n      \"action\": \"defer\",\n      \"reason\": \"Native closed-schema validation exists, but schema synchronization and generator drift adapters are deferred pending a measured domain integration.\",\n      \"evidence\": [\n        \"AGENTS.md\",\n        \"justfile\",\n        \".claude/skills/curate-scale-transfer/SKILL.md\",\n        \"conf/record_review.yaml\"\n      ]\n    },\n    \"skill:review-open-issues\": {\n      \"action\": \"adopt\",\n      \"reason\": \"