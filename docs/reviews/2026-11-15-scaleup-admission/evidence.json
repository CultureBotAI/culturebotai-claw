      "content": "name: Strict validation\non:\n  pull_request: {}\n  push: {}\n  merge_group:\n    types: [checks_requested]\npermissions:\n  contents: read\nconcurrency:\n  group: validate-${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\njobs:\n  validate-strict:\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    steps:\n      - name: Checkout\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - name: Install uv\n        uses: astral-sh/setup-uv@bec219d24cd3e171d82865faccec33120bb574f4 # v10.1.0\n        with:\n          version: \"0.12.5\"\n          python-version: \"3.13\"\n          enable-cache: true\n      - name: Install just\n        run: uv tool install rust-just==1.46.0\n      - name: Install locked dependencies\n        run: uv sync --locked\n      - name: Verify immutable review event boundary\n        run: just check-review-event-base\n      - name: Native checks\n        run: just check\n      - name: Canonical governance\n        run: just check-vendored\n"
    },
