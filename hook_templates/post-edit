#!/bin/bash
# Managed by kg-microbe coordination hook installer.
#
# Claude Code Post-Edit Hook
# Updates status file after successful edit
#
# This hook is called after Claude successfully edits a file.
#

set -euo pipefail

# Configuration
ORCHESTRATION_ROOT={{ORCHESTRATION_ROOT}}  # Replaced during installation
REPO_NAME={{REPO_NAME}}  # Replaced during installation
WORKSPACE={{WORKSPACE_ROOT}}  # Replaced during installation
PROJECT_ROOT={{PROJECT_ROOT}}  # Replaced during installation
HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOOK_INPUT_FILTER="$HOOKS_DIR/hook-input.py"
STATUS_DIR="$WORKSPACE/status"
CLAUDE_ID="${REPO_NAME}_claude"
export CLAUDE_PROJECT_DIR="$PROJECT_ROOT"

if [ -L "$HOOK_INPUT_FILTER" ] || [ ! -f "$HOOK_INPUT_FILTER" ]; then
    exit 0
fi
if ! command -v python3 >/dev/null 2>&1; then
    exit 0
fi
if ! python3 "$HOOK_INPUT_FILTER" edit PostToolUse; then
    exit 0
fi

if [ -L "$WORKSPACE" ] || [ -L "$STATUS_DIR" ]; then
    echo "Status workspace and directory must not be symlinks" >&2
    exit 1
fi
mkdir -p "$STATUS_DIR"
STATUS_FILE="$STATUS_DIR/${CLAUDE_ID}_status.yaml"
TEMPORARY_FILE="$(mktemp "$STATUS_DIR/.${CLAUDE_ID}.XXXXXX")"
trap 'rm -f "$TEMPORARY_FILE"' EXIT
TIMESTAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Update status atomically so readers never observe a partial YAML document.
cat > "$TEMPORARY_FILE" <<EOF
last_updated: '$TIMESTAMP'
status: idle
current_operation: null
last_completed_operation:
  type: edit
  timestamp: '$TIMESTAMP'
  result: success
next_available_at: '$TIMESTAMP'
EOF
if [ -d "$STATUS_FILE" ]; then
    echo "Status file destination must not be a directory: $STATUS_FILE" >&2
    exit 1
fi
mv "$TEMPORARY_FILE" "$STATUS_FILE"
trap - EXIT

exit 0
