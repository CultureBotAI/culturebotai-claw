<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ stats.repo_name }} — QC Dashboard</title>
{{ chrome.head }}
<style>
{{ chrome.css }}
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
         margin: 2em; color: var(--fg); background: var(--page); max-width: 1100px; }
  h1 { border-bottom: 2px solid var(--rule); padding-bottom: 0.3em; }
  .meta { color: var(--muted); font-size: 0.9em; margin-bottom: 1.5em; }
  * { box-sizing: border-box; }
  body { overflow-wrap: anywhere; }
  a { color: var(--accent); }
  .stat-grid { display: flex; flex-wrap: wrap; gap: 1.5em; margin: 1em 0 2em 0; }
  .stat { flex: 1 1 12em; min-width: 0; padding: 1em; border-radius: 6px; background: var(--card);
          border: 1px solid var(--card-line); }
  .stat .label { color: var(--muted); font-size: 0.85em; text-transform: uppercase;
                 letter-spacing: 0.05em; }
  .stat .value { font-size: 2em; font-weight: 600; margin-top: 0.2em; }
  .pass { color: var(--pass); }
  .warn { color: var(--warn); }
  .fail { color: var(--fail); }
  table { border-collapse: collapse; width: 100%; margin-top: 1em;
          font-size: 0.9em; }
  th, td { padding: 0.5em 0.8em; text-align: left;
           border-bottom: 1px solid var(--line); }
  th { background: var(--card); font-weight: 600; }
  td.right { text-align: right; font-variant-numeric: tabular-nums; }
  .badge { display: inline-block; padding: 0.15em 0.55em; border-radius: 3px;
           font-size: 0.8em; font-weight: 600; }
  .badge.pass { background: var(--pass-bg); color: var(--pass-fg); }
  .badge.warn { background: var(--warn-bg); color: var(--warn-fg); }
  .badge.fail { background: var(--fail-bg); color: var(--fail-fg); }
  .required { color: var(--muted); }
  img { max-width: 100%; margin-top: 1em; border: 1px solid var(--line);
        border-radius: 4px; }
  .table-scroll { max-width: 100%; overflow-x: auto; }
  .table-scroll table { min-width: 36em; }
  a:focus-visible, .table-scroll:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .skip-link { position: absolute; top: -5em; left: 1em; background: var(--page); padding: .6em; }
  .skip-link:focus { top: .5em; }
  .site-footer { margin-top: 2em; padding-top: 1em; }
  @media (max-width: 40em) { body { margin: 1em; } }
</style>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to dashboard</a>
<div class="topbar">
<nav aria-label="Project navigation"><a href="https://culturebotai.github.io/mechs/">All Mech projects</a></nav>
{{ chrome.toggle }}
</div>
<main id="main-content" tabindex="-1">
<h1>{{ stats.repo_name }} — QC Dashboard</h1>
{# "Latest curation", not "generated" or "corpus as of": this is the newest
   recorded curation event, a lower bound on corpus age. The source count is
   shown because a date resting on 2 of 311 records means something very
   different from one resting on 477 of 477. #}
{% if stats.timestamp %}
<div class="meta">Latest curation {{ stats.timestamp }}
  (from {{ "{:,}".format(stats.timestamp_sources) }} of
  {{ "{:,}".format(stats.record_count) }} records)</div>
{% else %}
<div class="meta">Latest curation unknown — no record carries a curation timestamp</div>
{% endif %}

<div class="stat-grid">
  <div class="stat">
    <div class="label">Records</div>
    <div class="value">{{ "{:,}".format(stats.record_count) }}</div>
  </div>
  <div class="stat">
    <div class="label">Slots tracked</div>
    <div class="value">{{ stats.scores|length }}</div>
  </div>
  <div class="stat">
    <div class="label">Overall coverage</div>
    <div class="value">{{ "{:.1%}".format(stats.overall_coverage) }}</div>
  </div>
  <div class="stat">
    <div class="label">FAIL slots</div>
    <div class="value {% if stats.fail_count %}fail{% else %}pass{% endif %}">
      {{ stats.fail_count }}
    </div>
  </div>
</div>

{% if stats.scores %}
<img src="coverage.png" alt="Slot coverage chart">

<h2>Per-slot detail</h2>
<div class="table-scroll" role="region" tabindex="0" aria-label="Per-slot coverage">
<table>
  <caption>Slot population, coverage and quality thresholds</caption>
  <thead>
    <tr>
      <th scope="col">Slot</th>
      <th scope="col" class="right">Populated</th>
      <th scope="col" class="right">Coverage</th>
      <th scope="col" class="right">Threshold</th>
      <th scope="col">Status</th>
    </tr>
  </thead>
  <tbody>
    {% for s in stats.scores %}
    <tr>
      <td><code>{{ s.slot }}</code></td>
      <td class="right">{{ "{:,}".format(s.populated) }} / {{ "{:,}".format(s.expected) }}</td>
      <td class="right">{{ "{:.1%}".format(s.coverage) }}</td>
      <td class="right">{{ "{:.0%}".format(s.threshold) }}</td>
      <td>
        <span class="badge {{ s.status|lower }}">{{ s.status }}</span>
        {% if s.required %}<small class="required"> required</small>{% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p><em>No slots configured.</em></p>
{% endif %}
</main>
{{ chrome.footer }}
</body>
</html>
