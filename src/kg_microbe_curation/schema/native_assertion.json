{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/culturebotai/claw/curation/v1/native-assertion.schema.json",
  "title": "Native assertion with inherited review provenance",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "assertion_id", "native_locator", "payload", "evidence", "native_review", "assurance", "limitations", "independent_scientific_review"],
  "properties": {
    "contract": {"const": "kg-microbe-native-assertion/v1"},
    "assertion_id": {"type": "string", "pattern": "^urn:kg-microbe:native-assertion:v1:[0-9a-f]{64}(?![\\s\\S])"},
    "native_locator": {
      "allOf": [{"$ref": "#/$defs/locator_fields"}],
      "type": "object", "unevaluatedProperties": false,
      "required": ["payload_sha256", "source_sha256"],
      "properties": {"payload_sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "predicate", "object", "context", "interpretation", "native_payload"],
      "properties": {
        "subject": {"$ref": "#/$defs/nonblank"}, "predicate": {"$ref": "#/$defs/nonblank"},
        "object": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/nonblank"}]},
        "context": {"type": "object"}, "interpretation": {"$ref": "#/$defs/interpretation"},
        "native_payload": {"type": "object"}
      }
    },
    "evidence": {"type": "array", "minItems": 1, "maxItems": 50000, "items": {"$ref": "#/$defs/evidence"}},
    "native_review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "locator", "sha256", "payload", "payload_sha256", "rationale"],
      "properties": {
        "status": {"enum": ["supported", "withheld", "unassessed"]},
        "locator": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/locator"}]},
        "sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "payload": {"type": "object"}, "payload_sha256": {"$ref": "#/$defs/sha256"},
        "rationale": {"$ref": "#/$defs/nonblank"}
      }
    },
    "assurance": {"enum": ["inherited_native_review", "native_withheld_decision", "unassessed"]},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/nonblank"}},
    "independent_scientific_review": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "nonblank": {"type": "string", "pattern": "\\S", "maxLength": 16384},
    "interpretation": {
      "description": "Named, pinned interpretation of lexical payload values; separate from biological context and native identity provenance.",
      "type": "object", "additionalProperties": false,
      "required": ["normalization_contract", "normalizer_contract_sha256", "schema_sha256", "prefix_map_sha256"],
      "properties": {
        "normalization_contract": {"$ref": "#/$defs/nonblank"},
        "normalizer_contract_sha256": {"$ref": "#/$defs/sha256"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "prefix_map_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "locator_fields": {
      "type": "object", "required": ["repository", "commit", "path", "selector"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*/[A-Za-z0-9_.-]+(?![\\s\\S])"},
        "commit": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"},
        "path": {"$ref": "#/$defs/nonblank"}, "selector": {"type": "object"}
      }
    },
    "locator": {"allOf": [{"$ref": "#/$defs/locator_fields"}], "unevaluatedProperties": false},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "locator", "sha256", "ancestry"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/nonblank"}, "locator": {"$ref": "#/$defs/locator"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "ancestry": {"type": "array", "uniqueItems": true, "maxItems": 10000, "items": {"$ref": "#/$defs/nonblank"}},
        "payload": {"type": "object"}
      }
    }
  }
}
