{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/culturebotai/claw/curation/v1/bundle.schema.json",
  "title": "Bounded edge-curation decision bundle",
  "description": "Immutable scoped decisions, not proof of scientific truth or authorization to publish.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "input_sha256", "occurrence_ids", "decisions", "observations", "claims", "reviews"],
  "properties": {
    "contract": {"const": "kg-microbe-curation/v1"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "occurrence_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/occurrence_id"}},
    "decisions": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/decision"}},
    "observations": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/observation"}},
    "claims": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/claim"}},
    "reviews": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/review"}}
  },
  "$defs": {
    "nonblank": {"type": "string", "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "occurrence_id": {"type": "string", "pattern": "^urn:kg-microbe:occurrence:v1:[0-9a-f]{64}(?![\\s\\S])"},
    "observation_id": {"type": "string", "pattern": "^urn:kg-microbe:observation:v1:[0-9a-f]{64}(?![\\s\\S])"},
    "claim_id": {"type": "string", "pattern": "^urn:kg-microbe:claim:v1:[0-9a-f]{64}(?![\\s\\S])"},
    "context_id": {"type": "string", "pattern": "^urn:kg-microbe:context:v1:[0-9a-f]{64}(?![\\s\\S])"},
    "interpretation": {
      "description": "Named, pinned interpretation of lexical payload values; separate from biological context and native identity provenance.",
      "type": "object", "additionalProperties": false,
      "required": ["normalization_contract", "normalizer_contract_sha256", "schema_sha256", "prefix_map_sha256"],
      "properties": {
        "normalization_contract": {"$ref": "#/$defs/nonblank"},
        "normalizer_contract_sha256": {"$ref": "#/$defs/sha256"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "prefix_map_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "native_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["identifier", "algorithm", "normalizer_contract_sha256", "schema_sha256", "prefix_map_sha256"],
      "properties": {
        "identifier": {"$ref": "#/$defs/nonblank"},
        "algorithm": {"$ref": "#/$defs/nonblank"},
        "normalizer_contract_sha256": {"$ref": "#/$defs/sha256"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "prefix_map_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "observation": {
      "description": "A curation fingerprint of exact supplied payload; native identity is preserved separately and is not rederived here.",
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "payload", "context_id"],
      "properties": {
        "observation_id": {"$ref": "#/$defs/observation_id"},
        "payload": {
          "type": "object", "required": ["context", "interpretation"],
          "properties": {
            "context": {"type": "object"},
            "interpretation": {"$ref": "#/$defs/interpretation"}
          }
        },
        "context_id": {"$ref": "#/$defs/context_id"},
        "native_identity": {"$ref": "#/$defs/native_identity"}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "payload", "context_id", "observation_ids"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/claim_id"},
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["subject", "predicate", "object", "context", "interpretation", "epistemic_kind"],
          "properties": {
            "subject": {"$ref": "#/$defs/nonblank"},
            "predicate": {"$ref": "#/$defs/nonblank"},
            "object": {"$ref": "#/$defs/nonblank"},
            "context": {"type": "object"},
            "interpretation": {"$ref": "#/$defs/interpretation"},
            "epistemic_kind": {"enum": ["observational", "computational", "causal", "unspecified"]},
            "qualifiers": {"type": "object"}
          }
        },
        "context_id": {"$ref": "#/$defs/context_id"},
        "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/observation_id"}}
      }
    },
    "review": {
      "description": "Existing canonical RecordReview with a digest of its canonical JSON. Validation checks shape and binding, not source authenticity.",
      "type": "object", "additionalProperties": false,
      "required": ["review_id", "sha256", "document"],
      "properties": {
        "review_id": {"$ref": "#/$defs/nonblank"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "document": {"type": "object"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["occurrence_id", "lifecycle", "review_state", "conflict_state", "disposition", "claim_ids", "observation_id", "review_ids", "rationale"],
      "properties": {
        "occurrence_id": {"$ref": "#/$defs/occurrence_id"},
        "lifecycle": {"enum": ["active", "superseded", "retracted"]},
        "review_state": {"enum": ["unprocessed", "in_review", "reviewed", "deferred"]},
        "conflict_state": {"enum": ["not_assessed", "none_reported", "unresolved", "resolved"]},
        "disposition": {"enum": ["withheld", "retain", "amend", "exclude"]},
        "claim_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/claim_id"}},
        "observation_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/observation_id"}]},
        "review_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonblank"}},
        "rationale": {"$ref": "#/$defs/nonblank"}
      }
    }
  }
}
